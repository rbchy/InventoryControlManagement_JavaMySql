<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.eclipse.jdt.launching.localJavaApplication">
    <listAttribute key="org.eclipse.debug.core.MAPPED_RESOURCE_PATHS">
        <listEntry value="/InventoryControlManagement/src/com/pharma/inventory/app/InventoryManagementApp.java"/>
    </listAttribute>
    <listAttribute key="org.eclipse.debug.core.MAPPED_RESOURCE_TYPES">
        <listEntry value="1"/>
    </listAttribute>
    <mapAttribute key="org.eclipse.debug.core.environmentVariables">
        <mapEntry key="DB_PASSWORD" value="CHANGE_ME_IN_RUN_CONFIGURATIONS"/>
        <mapEntry key="DB_URL" value="jdbc:mysql://localhost:3306/pharma_inventory?useSSL=false&amp;allowPublicKeyRetrieval=true"/>
        <mapEntry key="DB_USER" value="pharma_app"/>
    </mapAttribute>
    <stringAttribute key="org.eclipse.jdt.launching.MAIN_TYPE" value="com.pharma.inventory.app.InventoryManagementApp"/>
    <stringAttribute key="org.eclipse.jdt.launching.PROJECT_ATTR" value="InventoryControlManagement"/>
</launchConfiguration>
